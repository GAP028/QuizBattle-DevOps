# Port d'écoute de l'API
# - en local sous Windows : 3002 (3000 et 3001 sont déjà utilisés sur la machine)
# - dans le conteneur Docker : 3000 (publié sur l'hôte en 3002)
PORT=3002

# Connexion PostgreSQL : conteneur quizbattle-db publié sur le port 5433 de l'hôte
DATABASE_URL=postgresql://quizuser:CHANGE_ME@localhost:5433/quizbattle

# Origines autorisées par CORS, séparées par des virgules (vide = toutes)
CORS_ORIGIN=
